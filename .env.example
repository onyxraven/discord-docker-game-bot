# Copy to .env next to your docker-compose.yml and fill in.

# Bot token from https://discord.com/developers/applications -> Bot -> Token
DISCORD_TOKEN=

# Server (guild) ID - right-click server icon -> Copy Server ID (developer mode on)
DISCORD_GUILD_ID=

# Comma-separated role IDs allowed to use /restart (/players is open to everyone)
DISCORD_ROLE_IDS=

# Comma-separated compose files to scan for discord.restart.* labels.
# Each file's directory must also be volume-mounted into the bot container
# read-only at the same path as on the host.
COMPOSE_FILES=/opt/games/docker-compose.yml

# Seconds between the channel warning and the actual restart (0 = immediate)
WARN_DELAY_SECONDS=10

# Channel ID for unattended maintenance announcements (maintenance runner);
# the bot must be able to send messages there. Empty = no announcements.
DISCORD_CHANNEL_ID=

# Unattended maintenance tuning; MAINT_UP_TIMEOUT_SECONDS also bounds the
# "wait until back up" check after any restart, slash-command included.
MAINT_RETRY_SECONDS=300
MAINT_MAX_ATTEMPTS=6
MAINT_UP_TIMEOUT_SECONDS=300
